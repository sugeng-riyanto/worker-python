# Export worker. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
QUARTO_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Cloud Run sets PORT and the process listens on 0.0.0.0.
# QUARTO_WORKER_PORT is used only when PORT is unset.
PORT=8080
# QUARTO_WORKER_BIND=127.0.0.1
# QUARTO_WORKER_PORT=8765

MAX_RUNNING_JOBS=1
MAX_QUEUED_JOBS=8
MAX_RETAINED_JOBS=40
JOB_TTL_SECONDS=1800
MAX_ZIP_BYTES=25165824
RENDER_TIMEOUT_SECONDS=240
JOB_ROOT=/tmp/physics-studio-jobs

# Generator. Keys travel in headers, never in the URL.
# LLM_PROVIDERS is the fallback order. Omit it to use every provider that has a key.
LLM_PROVIDERS=gemini,deepseek
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=16384
# Live DeepSeek ids: deepseek-flash (V4.1 Flash) and deepseek-v4-pro.
# deepseek-chat and deepseek-reasoner were retired on 2026-07-24; they still
# work here as aliases of non-thinking and thinking deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_OUTPUT_TOKENS=16384
BOOK_AUTHOR=Academic Physics Publishing Team
BOOK_LANG=id
BOOK_PUBLISHER=Physics Textbook Studio

# Service account JSON, either inline or as a file path. Do not commit either.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_FOLDER_NAME=Physics Textbook Series (BSKAP 2025 + CIE & IB)
SHEET_ID=
